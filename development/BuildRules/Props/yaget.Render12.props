<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets">
    <Import Project="yaget.DX12.ShaderCompiler.props" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup />
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(YAGET_DEPENDENCIES_FOLDER)\AgilitySDK\build\native\include\d3dx12;$(YAGET_DEPENDENCIES_FOLDER)\AgilitySDK\build\native\include\;$(YAGET_ROOT_FOLDER)\Common\Render\Include\DX12;$(YAGET_DEPENDENCIES_FOLDER)\DirectX-Headers\include\directx;$(YAGET_DEPENDENCIES_FOLDER)\DirectX-Headers\include\dxguids;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>YagetRender12$(YAGET_DEBUG_SUFFIX).lib;DirectXTK12.lib;DirectX-Guids.lib;DXGI.lib;D3d12.lib;d3dcompiler.lib;dxguid.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(YAGET_DEPENDENCIES_FOLDER)\builds\DirectX-Headers\$(Configuration);$(YAGET_DEPENDENCIES_FOLDER)builds\DirectXTK12\lib\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <FxCompile />
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>