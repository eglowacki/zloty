<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets">
  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <YAGET_ROOT_FOLDER>c:\Development\yaget\branch\zloty\development</YAGET_ROOT_FOLDER>
    <YAGET_RUN_FOLDER>$(YAGET_ROOT_FOLDER)\bin\$(ProjectName)\$(Platform).$(Configuration)\</YAGET_RUN_FOLDER>
    <YAGET_DEPENDENCIES_FOLDER>$(YAGET_ROOT_FOLDER)\Dependencies</YAGET_DEPENDENCIES_FOLDER>
    <YAGET_GLOBAL_DEPENDENCIES_FOLDER>C:\Development\yaget\Dependencies</YAGET_GLOBAL_DEPENDENCIES_FOLDER>
  </PropertyGroup>
  <PropertyGroup>
  </PropertyGroup>
  <ItemDefinitionGroup>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="YAGET_ROOT_FOLDER">
      <Value>$(YAGET_ROOT_FOLDER)</Value>
    </BuildMacro>
    <BuildMacro Include="YAGET_RUN_FOLDER">
      <Value>$(YAGET_RUN_FOLDER)</Value>
    </BuildMacro>
    <BuildMacro Include="YAGET_DEPENDENCIES_FOLDER">
      <Value>$(YAGET_DEPENDENCIES_FOLDER)</Value>
    </BuildMacro>
    <BuildMacro Include="YAGET_GLOBAL_DEPENDENCIES_FOLDER">
      <Value>$(YAGET_GLOBAL_DEPENDENCIES_FOLDER)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>