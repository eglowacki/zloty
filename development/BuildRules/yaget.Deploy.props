<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <PostBuildEventUseInBuild>false</PostBuildEventUseInBuild>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <PostBuildEvent>
      <Command>$(YAGET_GLOBAL_DEPENDENCIES_FOLDER)\..\DevTools\DependencyDeployment\deploy.py --root=$(YAGET_GLOBAL_DEPENDENCIES_FOLDER);$(YAGET_DEPENDENCIES_FOLDER) --configuration=$(Configuration) --destination=$(YAGET_RUN_FOLDER) --metafile=$(ProjectDir)$(TargetName).deployment</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <PostBuildEvent>
      <Message>Executing dependency update for '$(YAGET_GLOBAL_DEPENDENCIES_FOLDER)' using configuration '$(Configuration)' with metafile '$(ProjectDir)$(TargetName).deployment'</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>