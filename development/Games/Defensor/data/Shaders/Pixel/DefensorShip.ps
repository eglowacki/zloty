Texture2D<float4> ShipHullTexture   : register(t0);
SamplerState ShipHullSampler        : register(s0);


struct PSInput
{
    float4 position : SV_POSITION;
    float4 color    : COLOR;
    float2 uv       : TEXCOORD0;
};


float4 PSMain(PSInput input) : SV_TARGET
{
    float4 sampledColor = ShipHullTexture.Sample(ShipHullSampler, input.uv) * input.color;
    //if (sampledColor.a < 0.01f)
    //{
    //    discard;
    //}
    return sampledColor;
}
