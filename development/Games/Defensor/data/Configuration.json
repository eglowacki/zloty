{
	"Configuration" : {
		"Debug": {
			"Logging": {
				"Filters": [ "INPT", "WIND", "MULT", "POOL", "WIN", "APP", "METR", "!GSYS" ],
				"Level": "INFO",
				"Outputs": {
					"ylog::OutputDebug": {
						"split_lines": "true"																											
					},
					"ylog::OutputFile": {
						"max_startup_size": "0",
						"filename": "$(LogFolder)/$(AppName).log"
					}
				},
				"PrintThreadName": true,
				"TruncateFunctionName": true,
				"MaxFunctionNameLen": 40
			},
			"Metrics": {
				"AllowFallbackToFile": false,
				"AllowSocketConnection": false,
				"SocketConnectionTimeout": 100,
				"TraceFileName": "$(Temp)/Traces/$(AppName)_trace.json",
				"TraceOn": true
			}
		},
		"Graphics": {																				   
			"Device": "",
			"MemoryReport": false,
			"GPUTraceback": false
		},
		"Init": {
			"Aliases": {
				"$(AssetsFolder)": {
					"Path": "$(UserDataFolder)/Assets",
					"ReadOnly": true
				},
				"$(DatabaseFolder)": {
					"Path": "$(UserDataFolder)/Database",
					"ReadOnly": true
				}
			},
			"VTS": [
				{
					"Settings": {
						"Converters": "JSON",
						"Filters": [ "*.json" ],
						"Path": [ "$(DataFolder)/Data", "$(AppFolder)" ],
						"ReadOnly": true,
						"Recursive": false
					}
				},
				{
					"Persistance": {
						"Converters": "PERS",
						"Filters": [ "*.pers" ],
						"Path": [ "$(AppFolder)" ],
						"ReadOnly": true,
						"Recursive": false
					}
				},
				{
					"UserOptions": {
						"Converters": "JSON",
						"Filters": [ "*.json" ],
						"Path": [ "$(UserDataFolder)/UserOptions" ],
						"ReadOnly": false,
						"Recursive": false
					}
				},
				{
					"VeretexShaders": {
						"Converters": "COMP",
						"Filters": [ "*.vs" ],
						"Path": [ "$(DataFolder)/Data/Shaders/Vertex" ],
						"ReadOnly": true,
						"Recursive": false
					}
				},
				{
					"PixelShaders": {
						"Converters": "COMP",
						"Filters": [ "*.ps" ],
						"Path": [ "$(DataFolder)/Data/Shaders/Pixel" ],
						"ReadOnly": true,
						"Recursive": false
					}
				},
				{
					"Caches": {
						"Converters": "BIN",
						"Filters": [ "*.cache" ],
						"Path": [ "$(AppDataFolder)/Caches" ],
						"ReadOnly": false,
						"Recursive": false
					}
				}
			],
			"WindowOptions": "UserOptions@WindowConfiguration",
			"VSync": false,
			"StartingStage": "Boot",
			"ItemsFile": ""
		}
	}
}
